# Server-side only — never prefix with EXPO_PUBLIC_
# This key is read by the Expo Router API route at app/api/chat+api.ts
# It is never bundled into the client.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Server-side only — never prefix with EXPO_PUBLIC_
# Powers Ember's spoken voice (text-to-speech) via ElevenLabs.
# Read by the Expo Router API route at app/api/speak+api.ts.
ELEVENLABS_API_KEY=...

# Optional: override the ElevenLabs voice and model
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5
