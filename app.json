{
  "expo": {
    "name": "CBT Companion",
    "slug": "cbt-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cbt-companion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.placeholder.cbtcompanion",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F2"
      },
      "package": "com.placeholder.cbtcompanion",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ember uses the microphone so you can talk to it hands-free while driving.",
          "speechRecognitionPermission": "Ember uses on-device speech recognition to understand what you say."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
