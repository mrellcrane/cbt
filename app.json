{
  "expo": {
    "name": "CBT Companion",
    "slug": "cbt-companion",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cbt-companion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elliottcrane.cbtcompanion",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Ember uses on-device speech recognition to understand what you say.",
        "NSMicrophoneUsageDescription": "Ember uses the microphone so you can talk to it hands-free while driving."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F2"
      },
      "package": "com.elliottcrane.cbtcompanion",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://cbt-companion.expo.app"
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ember uses the microphone so you can talk to it hands-free while driving.",
          "speechRecognitionPermission": "Ember uses on-device speech recognition to understand what you say."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "337ad212-4549-4c01-8376-4205af4034aa"
      }
    },
    "owner": "elliottcrane"
  }
}
